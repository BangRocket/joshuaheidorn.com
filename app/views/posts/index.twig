{% extends 'layout.twig' %}

{% block content %}
<div class="posts-page">
    <header class="page-header">
        <h1 class="page-title">All Posts</h1>
        <p class="page-description">{{ posts|length }} {{ posts|length == 1 ? 'article' : 'articles' }}</p>
    </header>

    {% if posts is empty %}
        <p class="empty">No posts yet.</p>
    {% else %}
        <div class="posts-list">
            {% for post in posts %}
                <article class="post-item">
                    <a href="/posts/{{ post.slug }}" class="post-link">
                        <div class="post-meta">
                            {% if post.published_at %}<time>{{ post.published_at|date('F j, Y') }}</time><span class="meta-dot"></span>{% endif %}
                            <span>{{ post.reading_time }} min read</span>
                        </div>
                        <h2 class="post-title">{{ post.title }}</h2>
                        {% if post.excerpt %}<p class="post-excerpt">{{ post.excerpt }}</p>{% endif %}
                    </a>
                    {% if post.tags is not empty %}
                        <div class="post-tags">
                            {% for t in post.tags|slice(0, 3) %}<a href="/tag/{{ t.slug }}" class="post-tag">{{ t.label }}</a>{% endfor %}
                        </div>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
