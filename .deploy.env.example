# Copy to .deploy.env (gitignored) and fill in. Used by ./deploy.sh.

# SSH target for the shared host:
DEPLOY_HOST=user@your-host.example.com
# SSH port (Hostinger uses a custom port, e.g. 65002):
DEPLOY_PORT=22
# Absolute path to the app directory on the host. This sits ABOVE the web root
# (public_html), which should be a symlink to <DEPLOY_PATH>/public.
DEPLOY_PATH=/home/user/domains/example.com/site
# PHP binary on the host for Composer + Phinx (the default `php` may be too old).
# On Hostinger: /opt/alt/php82/usr/bin/php  (or php83)
PHP_BIN=php
