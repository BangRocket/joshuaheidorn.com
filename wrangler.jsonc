{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "joshuaheidorn",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "joshuaheidorn-content",
			"database_id": "b3ce9b60-bb46-40fd-b91c-f6665b3b9ee7",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "joshuaheidorn-media"
		}
	],
	// Worker Loader for plugin sandboxing (EmDash plugins)
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	]
}
