{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "joshuaheidorn",
	"main": "./src/worker.ts",
	"workers_dev": true,
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{ "pattern": "joshuaheidorn.com", "custom_domain": true, "zone_name": "joshuaheidorn.com" },
		{ "pattern": "www.joshuaheidorn.com", "custom_domain": true, "zone_name": "joshuaheidorn.com" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "joshuaheidorn-content",
			"database_id": "bcdd5c52-b241-40d7-96e6-6c6c382f86ba"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "joshuaheidorn-media"
		}
	],
	// Worker Loader for plugin sandboxing (EmDash plugins)
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	]
}
