{
    "name": "joshuaheidorn/site",
    "description": "joshuaheidorn.com — PHP + Svelte",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "league/commonmark": "^2.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
