{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Projects",
	"type": "object",
	"required": ["projects"],
	"properties": {
		"$schema": { "type": "string" },
		"projects": {
			"type": "array",
			"items": { "$ref": "#/definitions/project" }
		}
	},
	"definitions": {
		"project": {
			"type": "object",
			"required": ["slug", "title", "summary"],
			"additionalProperties": false,
			"properties": {
				"slug": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
					"description": "URL slug. Lowercase, hyphen-separated."
				},
				"title": { "type": "string" },
				"summary": { "type": "string" },
				"featured_image": { "$ref": "#/definitions/image" },
				"external_url": { "type": "string", "format": "uri" },
				"source_url": { "type": "string", "format": "uri" },
				"featured": { "type": "boolean", "default": false },
				"tags": {
					"type": "array",
					"items": { "type": "string" },
					"default": []
				},
				"publishedAt": {
					"type": "string",
					"format": "date",
					"description": "ISO date (YYYY-MM-DD)."
				},
				"sections": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["heading", "body"],
						"additionalProperties": false,
						"properties": {
							"heading": { "type": "string" },
							"body": {
								"type": "string",
								"description": "Plain text. Use \\n\\n for paragraph breaks."
							}
						}
					}
				}
			}
		},
		"image": {
			"type": "object",
			"required": ["src"],
			"additionalProperties": false,
			"properties": {
				"src": {
					"type": "string",
					"description": "URL or absolute path. Media library URLs look like /_emdash/api/media/file/<id>.<ext>."
				},
				"alt": { "type": "string", "default": "" },
				"width": { "type": "integer" },
				"height": { "type": "integer" }
			}
		}
	}
}
