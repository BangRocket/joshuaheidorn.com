---
import Base from "../layouts/Base.astro";
import resume from "../data/resume.json";
import skills from "../data/skills.json";

const formatRange = (start?: string, end?: string) => {
	const s = start ?? "";
	const e = end ?? "";
	if (!s && !e) return "";
	if (!e) return s;
	return `${s} – ${e}`;
};
---
<Base title={`Resume · ${resume.name}`} description={resume.headline}>
	<main class="resume">
		{resume._placeholder && (
			<p class="placeholder-banner">
				Placeholder resume content. Edit <code>src/data/resume.json</code> and <code>src/data/skills.json</code>.
			</p>
		)}

		<header class="intro">
			<h1 class="resume-name">{resume.name}</h1>
			{resume.headline && <p class="resume-headline">{resume.headline}</p>}
			{resume.summary && <p class="resume-summary">{resume.summary}</p>}
			<ul class="links">
				{resume.contact?.email && (
					<li><a href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a></li>
				)}
				{resume.contact?.location && <li>{resume.contact.location}</li>}
				{resume.contact?.links?.map((l) => (
					<li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
				))}
			</ul>
		</header>

		{resume.experience?.length > 0 && (
			<section>
				<h2>Experience</h2>
				<ol class="entries">
					{resume.experience.map((job) => (
						<li class="entry">
							<div class="entry-head">
								<span class="entry-role">{job.role}</span>
								<span class="entry-sep">·</span>
								<span class="entry-company">{job.company}</span>
								<span class="entry-range">{formatRange(job.start, job.end)}</span>
							</div>
							{job.location && <p class="entry-location">{job.location}</p>}
							{job.bullets?.length > 0 && (
								<ul class="entry-bullets">
									{job.bullets.map((b) => <li>{b}</li>)}
								</ul>
							)}
							{job.tags?.length > 0 && (
								<ul class="chips">
									{job.tags.map((t) => <li class="chip">{t}</li>)}
								</ul>
							)}
						</li>
					))}
				</ol>
			</section>
		)}

		{resume.education?.length > 0 && (
			<section>
				<h2>Education</h2>
				<ol class="entries">
					{resume.education.map((ed) => (
						<li class="entry">
							<div class="entry-head">
								<span class="entry-role">{ed.degree}</span>
								<span class="entry-sep">·</span>
								<span class="entry-company">{ed.school}</span>
								<span class="entry-range">{formatRange(ed.start, ed.end)}</span>
							</div>
							{ed.location && <p class="entry-location">{ed.location}</p>}
						</li>
					))}
				</ol>
			</section>
		)}

		{skills.categories?.length > 0 && (
			<section>
				<h2>Skills</h2>
				<div class="skill-cats">
					{skills.categories.map((cat) => (
						<div class="skill-cat">
							<h3>{cat.name}</h3>
							<ul class="chips">
								{cat.items.map((item) => <li class="chip">{item.name}</li>)}
							</ul>
						</div>
					))}
				</div>
			</section>
		)}
	</main>
</Base>

<style>
	.resume {
		max-width: 56rem;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 6rem;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}
	.placeholder-banner {
		margin: 0;
		padding: 0.75rem 1rem;
		background: var(--color-accent);
		border: 2px solid var(--color-border);
		color: var(--color-on-accent);
		font-family: var(--font-sans);
		font-size: 0.9rem;
	}
	.placeholder-banner code {
		font-family: var(--font-mono);
	}

	.intro {
		padding-bottom: 2rem;
		border-bottom: 2px solid var(--color-border);
	}
	.resume-name {
		font-family: var(--font-head);
		font-size: clamp(2.25rem, 6vw, 4rem);
		line-height: 1;
		margin: 0;
	}
	.resume-headline {
		font-family: var(--font-sans);
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		margin: 0.5rem 0 0;
	}
	.resume-summary {
		font-family: var(--font-sans);
		max-width: 48ch;
		margin: 1rem 0 0;
		color: var(--color-text-secondary);
		line-height: 1.6;
	}

	.links {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		font-family: var(--font-sans);
	}
	.links a {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.links a:hover { color: var(--color-accent-hover); }

	section h2 {
		font-family: var(--font-head);
		font-size: 1.5rem;
		margin: 0 0 1.25rem;
	}

	.entries {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.entry {
		padding: 1.25rem 1.5rem;
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		box-shadow: 3px 3px 0 0 var(--color-shadow);
	}

	.entry-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		font-family: var(--font-sans);
	}
	.entry-role {
		font-family: var(--font-head);
		font-size: 1.125rem;
	}
	.entry-sep { color: var(--color-muted); }
	.entry-company { font-weight: 500; }
	.entry-range {
		margin-left: auto;
		color: var(--color-muted);
		font-size: 0.95rem;
	}
	.entry-location {
		font-family: var(--font-sans);
		color: var(--color-muted);
		font-size: 0.9rem;
		margin: 0.25rem 0 0;
	}
	.entry-bullets {
		margin: 0.75rem 0 0 1.25rem;
		padding: 0;
		font-family: var(--font-sans);
		line-height: 1.55;
		color: var(--color-text);
	}
	.entry-bullets li { margin-bottom: 0.25rem; }

	.chips {
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		padding: 0.2rem 0.6rem;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: 2px solid var(--color-border);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.skill-cats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
	}
	.skill-cat h3 {
		font-family: var(--font-head);
		font-size: 1rem;
		margin: 0 0 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	@media (max-width: 640px) {
		.entry-range { margin-left: 0; width: 100%; }
	}
</style>
