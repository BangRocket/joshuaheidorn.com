---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import resume from "../data/resume.json";
import TypewriterHeadline from "../components/TypewriterHeadline.tsx";

const headlines =
	Array.isArray(resume.headlines) && resume.headlines.length > 0
		? resume.headlines
		: resume.headline
			? [resume.headline]
			: [];

const { entries: posts, cacheHint } = await getEmDashCollection("posts");
const { entries: projects } = await getEmDashCollection("projects");
const { siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

Astro.cache.set(cacheHint);

const recentPosts = posts
	.toSorted((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
	.slice(0, 3);

const featuredProjects = projects
	.filter((p) => p.data.featured === true)
	.slice(0, 3);

const formatDate = (d: Date | null | undefined) =>
	d ? d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : null;

const primaryEmail = resume.contact?.email ?? "";

const tiles = [
	{ href: "/resume", label: "Resume", hint: "Experience & skills" },
	{ href: "/projects", label: "Projects", hint: "Selected work" },
	{ href: "/posts", label: "Blog", hint: "Notes & writing" },
	{
		href: primaryEmail ? `mailto:${primaryEmail}` : "#",
		label: "Contact",
		hint: primaryEmail || "Get in touch",
	},
];
---

<Base title={resume.name} description={resume.summary ?? siteTagline}>
	<main class="home">
		<section class="hero">
			<p class="eyebrow">Hello,</p>
			<h1 class="name">I'm {resume.name}.</h1>
			<p class="headline">
				{headlines.length > 0 ? (
					<TypewriterHeadline phrases={headlines} client:load />
				) : (
					resume.headline
				)}
			</p>
			{resume.summary && <p class="summary">{resume.summary}</p>}
		</section>

		<section class="tiles">
			{tiles.map((t) => (
				<a class="tile" href={t.href}>
					<span class="tile-label">{t.label}</span>
					<span class="tile-hint">{t.hint}</span>
					<span class="tile-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</section>

		{featuredProjects.length > 0 && (
			<section class="strip">
				<header class="strip-header">
					<h2>Featured projects</h2>
					<a href="/projects">All projects →</a>
				</header>
				<ul class="strip-list">
					{featuredProjects.map((p) => (
						<li>
							<a href={`/projects/${p.id}`} class="strip-item">
								<span class="strip-title">{p.data.title ?? "Untitled"}</span>
								{p.data.summary && <span class="strip-summary">{p.data.summary}</span>}
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		{recentPosts.length > 0 && (
			<section class="strip">
				<header class="strip-header">
					<h2>Recent writing</h2>
					<a href="/posts">All posts →</a>
				</header>
				<ul class="strip-list">
					{recentPosts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`} class="strip-item">
								<span class="strip-title">{post.data.title ?? "Untitled"}</span>
								{formatDate(post.data.publishedAt) && (
									<time class="strip-date">{formatDate(post.data.publishedAt)}</time>
								)}
								{post.data.excerpt && <span class="strip-summary">{post.data.excerpt}</span>}
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
	</main>
</Base>

<style>
	.home {
		max-width: 72rem;
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
		display: flex;
		flex-direction: column;
		gap: 4rem;
	}

	.hero {
		padding: 2rem 0 1rem;
	}
	.eyebrow {
		font-family: var(--font-sans);
		font-size: 1.125rem;
		color: var(--color-muted);
		margin: 0 0 0.25rem;
	}
	.name {
		font-family: var(--font-head);
		font-size: clamp(2.5rem, 8vw, 5.5rem);
		line-height: 1;
		margin: 0;
		color: var(--color-text);
	}
	.headline {
		font-family: var(--font-sans);
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		font-weight: 500;
		color: var(--color-text);
		margin: 1rem 0 0;
		min-height: 1.5em;
	}
	.typewriter {
		display: inline-flex;
		align-items: baseline;
		white-space: pre;
	}
	.typewriter-caret {
		display: inline-block;
		margin-left: 2px;
		font-family: var(--font-head);
		color: var(--color-accent);
		font-weight: 700;
		animation: typewriter-blink 1s steps(1) infinite;
	}
	@keyframes typewriter-blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.typewriter-caret { animation: none; opacity: 1; }
	}
	.summary {
		font-family: var(--font-sans);
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 44ch;
		margin: 1.25rem 0 0;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
	}
	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1.5rem 1.5rem 2rem;
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		box-shadow: 4px 4px 0 0 var(--color-shadow);
		text-decoration: none;
		color: var(--color-text);
		transition: transform 0.12s ease, box-shadow 0.12s ease;
	}
	.tile:hover {
		transform: translate(-2px, -2px);
		box-shadow: 6px 6px 0 0 var(--color-shadow);
	}
	.tile:active {
		transform: translate(2px, 2px);
		box-shadow: none;
	}
	.tile-label {
		font-family: var(--font-head);
		font-size: 1.75rem;
		color: var(--color-text);
	}
	.tile-hint {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		color: var(--color-muted);
	}
	.tile-arrow {
		position: absolute;
		right: 1.25rem;
		bottom: 1rem;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.strip-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
		border-bottom: 2px solid var(--color-border);
		padding-bottom: 0.5rem;
	}
	.strip-header h2 {
		font-family: var(--font-head);
		font-size: 1.5rem;
		margin: 0;
	}
	.strip-header a {
		font-family: var(--font-sans);
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
	}
	.strip-header a:hover {
		color: var(--color-accent-hover);
	}

	.strip-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.strip-item {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.5rem 1rem;
		padding: 1rem 1.25rem;
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		text-decoration: none;
		color: var(--color-text);
		transition: background 0.12s ease;
	}
	.strip-item:hover {
		background: var(--color-surface);
	}
	.strip-title {
		font-family: var(--font-head);
		font-size: 1.125rem;
	}
	.strip-date {
		font-family: var(--font-sans);
		font-size: 0.875rem;
		color: var(--color-muted);
		grid-column: 2;
	}
	.strip-summary {
		grid-column: 1 / -1;
		font-family: var(--font-sans);
		color: var(--color-text-secondary);
		font-size: 0.95rem;
	}

	@media (max-width: 600px) {
		.home { padding: 2.5rem 1rem 4rem; gap: 3rem; }
	}
</style>
