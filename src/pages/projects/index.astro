---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import projectsData from "../../data/projects.json";

const sorted = [...projectsData.projects].sort((a, b) => {
	const da = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
	const db = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
	return db - da;
});
---
<Base title="Projects" description="Selected work">
	<main class="projects-page">
		<header class="page-head">
			<h1>Projects</h1>
			<p class="subtitle">Selected work. Case studies are one click in.</p>
		</header>

		{sorted.length === 0 ? (
			<section class="empty">
				<p>No projects yet. Add one to <code>src/data/projects.json</code>.</p>
			</section>
		) : (
			<section class="grid">
				{sorted.map((p) => (
					<ProjectCard
						title={p.title}
						summary={p.summary}
						featuredImage={p.featured_image}
						href={`/projects/${p.slug}`}
						tags={(p.tags ?? []).map((t) => ({ slug: t, label: t }))}
						externalUrl={p.external_url}
						sourceUrl={p.source_url}
					/>
				))}
			</section>
		)}
	</main>
</Base>

<style>
	.projects-page {
		max-width: 72rem;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 6rem;
	}
	.page-head {
		margin-bottom: 3rem;
		padding-bottom: 1.5rem;
		border-bottom: 2px solid var(--color-border);
	}
	.page-head h1 {
		font-family: var(--font-head);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		margin: 0;
	}
	.subtitle {
		font-family: var(--font-sans);
		color: var(--color-text-secondary);
		font-size: 1.125rem;
		margin: 0.5rem 0 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}

	.empty {
		padding: 3rem 0;
		font-family: var(--font-sans);
		color: var(--color-text-secondary);
	}
	.empty code {
		font-family: var(--font-mono);
		padding: 0.1rem 0.35rem;
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
	}
</style>
