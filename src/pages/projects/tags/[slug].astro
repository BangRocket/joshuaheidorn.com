---
import Base from "../../../layouts/Base.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import projectsData from "../../../data/projects.json";

const tag = Astro.params.slug;
if (!tag) return Astro.redirect("/404");

const hasTag = projectsData.projects.some((p) => (p.tags ?? []).includes(tag));
if (!hasTag) return Astro.redirect("/404");

const filtered = projectsData.projects
	.filter((p) => (p.tags ?? []).includes(tag))
	.sort((a, b) => {
		const da = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
		const db = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
		return db - da;
	});
---
<Base
	title={`Projects tagged "${tag}"`}
	description={`Projects tagged with ${tag}`}
>
	<main class="projects-tag">
		<header class="page-head">
			<a href="/projects" class="back">← All projects</a>
			<span class="eyebrow">Tag</span>
			<h1>{tag}</h1>
			<p class="count">
				{filtered.length} {filtered.length === 1 ? "project" : "projects"}
			</p>
		</header>

		{filtered.length === 0 ? (
			<p class="empty">No projects with this tag yet.</p>
		) : (
			<section class="grid">
				{filtered.map((p) => (
					<ProjectCard
						title={p.title}
						summary={p.summary}
						featuredImage={p.featured_image}
						href={`/projects/${p.slug}`}
						tags={(p.tags ?? []).map((t) => ({ slug: t, label: t }))}
						externalUrl={p.external_url}
						sourceUrl={p.source_url}
					/>
				))}
			</section>
		)}
	</main>
</Base>

<style>
	.projects-tag {
		max-width: 72rem;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 6rem;
	}
	.page-head {
		margin-bottom: 3rem;
		padding-bottom: 1.5rem;
		border-bottom: 2px solid var(--color-border);
	}
	.back {
		font-family: var(--font-sans);
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
	}
	.back:hover { color: var(--color-accent-hover); }
	.eyebrow {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--color-muted);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.page-head h1 {
		font-family: var(--font-head);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		margin: 0.25rem 0 0;
	}
	.count {
		font-family: var(--font-sans);
		color: var(--color-muted);
		margin: 0.5rem 0 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}
	.empty {
		padding: 3rem 0;
		font-family: var(--font-sans);
		color: var(--color-text-secondary);
	}
</style>
