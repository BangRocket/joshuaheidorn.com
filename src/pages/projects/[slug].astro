---
import Base from "../../layouts/Base.astro";
import projectsData from "../../data/projects.json";

const { slug } = Astro.params;
const project = projectsData.projects.find((p) => p.slug === slug);
if (!project) return Astro.redirect("/404");
const featuredImageUrl = project.featured_image?.src;
---
<Base
	title={project.title}
	description={project.summary}
	image={featuredImageUrl}
	type="article"
	publishedTime={project.publishedAt}
>
	<article class="case-study">
		<header class="cs-head">
			<a href="/projects" class="back">← All projects</a>
			<h1>{project.title}</h1>
			{project.summary && <p class="lede">{project.summary}</p>}
			{(project.tags ?? []).length > 0 && (
				<ul class="chips">
					{(project.tags ?? []).map((t) => (
						<li><a href={`/projects/tags/${t}`} class="chip">{t}</a></li>
					))}
				</ul>
			)}
			<div class="meta-links">
				{project.external_url && (
					<a href={project.external_url} target="_blank" rel="noopener noreferrer">Live ↗</a>
				)}
				{project.source_url && (
					<a href={project.source_url} target="_blank" rel="noopener noreferrer">Source ↗</a>
				)}
			</div>
		</header>

		{project.featured_image && (
			<figure class="hero">
				<img
					src={project.featured_image.src}
					alt={project.featured_image.alt ?? ""}
					width={project.featured_image.width}
					height={project.featured_image.height}
				/>
			</figure>
		)}

		{(project.sections ?? []).length > 0 && (
			<div class="body">
				{(project.sections ?? []).map((section) => (
					<section>
						<h2>{section.heading}</h2>
						{section.body.split(/\n\n+/).map((para) => (
							<p>{para}</p>
						))}
					</section>
				))}
			</div>
		)}
	</article>
</Base>

<style>
	.case-study {
		max-width: 48rem;
		margin: 0 auto;
		padding: 3rem 1.5rem 6rem;
	}
	.cs-head {
		margin-bottom: 2rem;
	}
	.back {
		font-family: var(--font-sans);
		display: inline-block;
		margin-bottom: 1.25rem;
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
	}
	.back:hover { color: var(--color-accent-hover); }

	.cs-head h1 {
		font-family: var(--font-head);
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.05;
		margin: 0;
	}
	.lede {
		font-family: var(--font-sans);
		font-size: 1.25rem;
		color: var(--color-text-secondary);
		margin: 1rem 0 0;
		max-width: 44ch;
	}

	.chips {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		padding: 0.2rem 0.6rem;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: 2px solid var(--color-border);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 500;
		text-decoration: none;
	}
	.chip:hover { background: var(--color-accent-hover); }

	.meta-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.25rem;
		font-family: var(--font-sans);
	}
	.meta-links a {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.meta-links a:hover { color: var(--color-accent-hover); }

	.hero {
		margin: 2rem 0;
		border: 2px solid var(--color-border);
	}
	.hero :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.body {
		font-family: var(--font-sans);
		font-size: 1.0625rem;
		line-height: 1.7;
	}
	.body h2 {
		font-family: var(--font-head);
		font-size: 1.75rem;
		margin: 2.5rem 0 1rem;
	}
	.body p {
		margin: 0 0 1.1rem;
	}
	.body a {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.body a:hover { color: var(--color-accent-hover); }
</style>
