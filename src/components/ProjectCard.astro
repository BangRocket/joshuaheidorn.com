---
import { Image } from "emdash/ui";

interface Props {
	title: string;
	summary?: string | null;
	featuredImage?: any;
	href: string;
	tags?: Array<{ slug: string; label: string }>;
	externalUrl?: string | null;
	sourceUrl?: string | null;
}

const { title, summary, featuredImage, href, tags = [], externalUrl, sourceUrl } = Astro.props;
---
<article class="project-card">
	<a href={href} class="cover-link" aria-label={title}>
		{featuredImage ? (
			<div class="cover">
				<Image image={featuredImage} />
			</div>
		) : (
			<div class="cover placeholder" aria-hidden="true">
				<span>{title.charAt(0)}</span>
			</div>
		)}
	</a>
	<div class="body">
		<h3 class="title"><a href={href}>{title}</a></h3>
		{summary && <p class="summary">{summary}</p>}
		{tags.length > 0 && (
			<ul class="tags">
				{tags.map((t) => (
					<li><a href={`/projects/tags/${t.slug}`} class="tag">{t.label}</a></li>
				))}
			</ul>
		)}
		{(externalUrl || sourceUrl) && (
			<div class="meta-links">
				{externalUrl && <a href={externalUrl} target="_blank" rel="noopener noreferrer">Live ↗</a>}
				{sourceUrl && <a href={sourceUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>}
			</div>
		)}
	</div>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		box-shadow: 4px 4px 0 0 var(--color-border);
		transition: transform 0.12s ease, box-shadow 0.12s ease;
	}
	.project-card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 6px 6px 0 0 var(--color-border);
	}

	.cover-link {
		display: block;
		border-bottom: 2px solid var(--color-border);
	}
	.cover {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--color-surface);
	}
	.cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.cover.placeholder {
		display: grid;
		place-items: center;
	}
	.cover.placeholder span {
		font-family: var(--font-head);
		font-size: 3rem;
		color: var(--color-on-accent);
	}

	.body {
		padding: 1.25rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.title {
		font-family: var(--font-head);
		font-size: 1.25rem;
		margin: 0;
	}
	.title a {
		color: var(--color-text);
		text-decoration: none;
	}
	.title a:hover { color: var(--color-accent-hover); }

	.summary {
		font-family: var(--font-sans);
		color: var(--color-text-secondary);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
	}

	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.tag {
		display: inline-block;
		padding: 0.15rem 0.55rem;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: 2px solid var(--color-border);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		text-decoration: none;
	}
	.tag:hover { background: var(--color-accent-hover); }

	.meta-links {
		display: flex;
		gap: 1rem;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		padding-top: 0.25rem;
	}
	.meta-links a {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.meta-links a:hover { color: var(--color-accent-hover); }
</style>
